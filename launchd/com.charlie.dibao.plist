<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.charlie.dibao</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>-B</string>
        <string>/Users/charliezong/Developer/home/service/dibao.py</string>
    </array>
    <key>KeepAlive</key>
    <true/>
    <key>RunAtLoad</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>30</integer>
    <key>WorkingDirectory</key>
    <string>/Users/charliezong/Developer/home/service</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>HOME</key>
        <string>/Users/charliezong</string>
    </dict>
    <!-- 正常日志由 dibao.py 自己按 config.toml 的 log_file 写 api.log（1 MB × 3 轮转）；下面两个只兜启动期崩溃 -->
    <key>StandardOutPath</key>
    <string>/Users/charliezong/Library/Logs/dibao/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/charliezong/Library/Logs/dibao/launchd.log</string>
</dict>
</plist>
